PIDFILE=/var/run/streamviewer_poll.pid

kill_stale_poll() {
    [[ -f "$PIDFILE" ]] || return 0
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null)
    if [[ "$pid" =~ ^[0-9]+$ ]] && grep -qs streamviewer_poll "/proc/$pid/cmdline"; then
        kill "$pid" 2>/dev/null
    fi
    rm -f "$PIDFILE"
}

(
    sleep 10
    CFG=/boot/config/plugins/streamviewer/streamviewer.cfg
    if grep -q 'STATS_ENABLED="1"' "$CFG" 2>/dev/null; then
        kill_stale_poll
        setsid /usr/local/emhttp/plugins/streamviewer/include/streamviewer_poll.sh >/dev/null 2>/dev/null </dev/null &
    fi
) &
